{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HackySack",
  "version": "1.0.0",
  "identifier": "com.hackysack.app",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HackySack",
        "url": "index.html",
        "width": 900,
        "height": 700,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis_hooks.nsi"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hackysack"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RTYzNzJDNTM5OTJCRUMKUldUc0s1bFRMRGZtWkhzRlF4MHdvSkhxWDJKWFhpV1VXbkx3STI1cG90SUFoei9iZEk0SkJDMU4K",
      "endpoints": [
        "https://github.com/hackysackapp/HackySack/releases/latest/download/latest.json"
      ]
    }
  }
}
